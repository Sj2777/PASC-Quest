# ──────────────────────────────────────────────────────────────────────────────
# QuizPop Backend — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Required in production. Used by Prisma ORM to connect to PostgreSQL.
# Secret: YES
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/quizpop?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
# The port the backend HTTP+WebSocket server listens on.
# Most hosting platforms inject this automatically.
# Required: NO (fallback: 3001)
# Secret: NO
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# The exact origin of the deployed frontend (no trailing slash).
# Used by Express CORS to allow credentials from the frontend.
# Required in production: YES
# Secret: NO
FRONTEND_URL="https://your-frontend-domain.com"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# All three must be long, random, independent strings.
# Required in production: YES
# Secret: YES

# Used to sign/verify short-lived poll attempt tokens (student gameplay flow)
JWT_SECRET="replace-with-a-long-random-string"

# Used to sign/verify 8-hour admin session cookies
ADMIN_JWT_SECRET="replace-with-a-different-long-random-string"

# Used to sign/verify 30-day student session cookies
STUDENT_JWT_SECRET="replace-with-yet-another-long-random-string"

# ── Seed Script (optional) ────────────────────────────────────────────────────
# Used only when running: npm run seed
# In production, ADMIN_PASSWORD is REQUIRED — seed will throw if missing.
# In development, seed falls back to admin123 if ADMIN_PASSWORD is unset.
# Secret: YES (treat as a credential)

# The email address for the bootstrapped super admin account.
# Required: NO (fallback: admin@quizpop.dev)
ADMIN_EMAIL="admin@yourorg.com"

# The password for the bootstrapped super admin account.
# Required in production: YES (seed will throw without it)
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# ── Runtime Environment ───────────────────────────────────────────────────────
# Controls cookie security (Secure=true, SameSite=None when 'production').
# Set to 'production' on your hosting platform.
# Required: NO (fallback: cookies use SameSite=Lax, Secure=false)
# Secret: NO
NODE_ENV="production"
