# ──────────────────────────────────────────────────────────────────────────────
# QuizPop Frontend — Environment Variable Reference
# Copy this file to .env.local and fill in the appropriate value.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ────────────────────────────────────────────────────────────
# The full URL of the backend API (no trailing slash).
# This is a PUBLIC build-time variable — it is baked into the JS bundle.
# Required in production: YES
# Secret: NO
#
# The WebSocket URL is derived automatically from this value:
#   http://...  →  ws://...
#   https://... →  wss://...
#
# Development fallback (if unset): http://localhost:3001
VITE_API_BASE="https://your-backend-domain.com"
